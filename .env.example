# 复制为 .env 后填入真实值
# 高德开放平台 Web 服务 Key: https://lbs.amap.com/
AMAP_API_KEY=your_amap_web_service_key
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT=5.0
AMAP_CACHE_TTL=300

# DeepSeek 控制台: https://platform.deepseek.com/ （任何 OpenAI 兼容服务均可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=15.0

# ===== Agent 编排 =====
# 普通子 Agent 节点超时（秒）：链式节点（extract=LLM+geocode、hotel=高德+LLM）需覆盖叠加耗时
NODE_TIMEOUT=30.0
# POI 节点超时（秒）：多路检索共享 3 QPS 限流器，独立放宽
POI_NODE_TIMEOUT=45.0
# Supervisor 聚合节点超时（秒，内含最多 3 次 LLM 编排）
AGGREGATE_NODE_TIMEOUT=45.0
# L2：LLM 路线编排最大尝试次数，超过即丢弃 LLM 走贪心算法
LLM_ARRANGE_MAX_ATTEMPTS=3

LOG_LEVEL=INFO
